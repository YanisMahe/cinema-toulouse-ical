LOCATION:ABC (SALLE C)\, 13 rue Saint-Bernard\, 31000 Toulouse
DTSTART:20260926T165000Z
SUMMARY:Rose (VOST)
UID:9e2305c2-96ba-435d-836b-986faf9478d1@9e23.org
END:VEVENT
